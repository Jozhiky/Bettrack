{
  "name": "bettrack",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "vite preview --host 127.0.0.1 --port 5187 --strictPort",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:historical:rollback": "node scripts/build-historical-rollback.mjs",
    "prebuild": "node scripts/check-ocr.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:captures:ui": "node scripts/capture-upload/run.mjs",
    "demo:captures": "node scripts/capture-upload/server.mjs --serve",
    "test:persistence:qa": "node --test tests/persistence-qa/target.test.mjs && node scripts/persistence-qa/run.mjs",
    "test:settled:qa": "node --test tests/persistence-qa/target.test.mjs && node scripts/persistence-qa/settled.mjs",
    "demo:persistence:qa": "node scripts/persistence-qa/server.mjs --serve",
    "test:ocr:baseline": "node scripts/ocr-phase1/run.mjs",
    "test:ocr:strict": "node scripts/ocr-phase1/run.mjs --strict",
    "test:ocr:phase2": "node scripts/ocr-phase1/run.mjs --phase2",
    "test:ocr:phase2:strict": "node scripts/ocr-phase1/run.mjs --phase2 --strict",
    "test:ocr:phase21": "node scripts/ocr-phase1/run.mjs --phase21",
    "test:ocr:phase21:strict": "node scripts/ocr-phase1/run.mjs --phase21 --strict",
    "test:ocr:placement": "node scripts/ocr-phase1/run.mjs --placement",
    "test:ocr:placement:strict": "node scripts/ocr-phase1/run.mjs --placement --strict",
    "test:ocr:phase3": "node scripts/ocr-phase1/run.mjs --phase3",
    "test:ocr:phase3:strict": "node scripts/ocr-phase1/run.mjs --phase3 --strict",
    "test:ocr:phase3:ui": "node scripts/ocr-phase3/review-ui.mjs",
    "test:ocr:phase3:compare": "node scripts/ocr-phase3/compare.mjs",
    "test:ocr:phase4a": "vitest run --maxWorkers=4 src/test/ocr-phase4a.test.ts src/test/ocr-phase4a-admission.test.ts src/test/ocr-phase2.test.ts src/test/ocr-phase21.test.ts",
    "test:ocr:phase4b:unit": "vitest run --maxWorkers=4 src/test/ocr-phase4b-evaluation.test.ts",
    "test:ocr:phase4b": "node scripts/ocr-phase4b/run.mjs",
    "test:ocr:phase4b:strict": "node scripts/ocr-phase4b/run.mjs --strict",
    "test:ocr:phase4c2": "vitest run --maxWorkers=4 && tsc --noEmit && npm run build && node scripts/ocr-phase4b/run.mjs",
    "test:ocr:compare": "node scripts/ocr-phase1/compare-phase2.mjs",
    "assets:ocr": "node scripts/prepare-ocr.mjs",
    "deploy:firebase": "npm run build && npx -y firebase-tools@latest deploy --only hosting:bettrack --project wostcloud1"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@jsquash/webp": "1.5.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "firebase": "13.0.0",
    "lucide-react": "1.57.0",
    "papaparse": "5.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "tesseract.js": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "dexie": "4.4.6",
    "fake-indexeddb": "6.2.5",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}
